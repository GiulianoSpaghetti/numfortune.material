<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0-preview.2.26479.13" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0-preview.2.26479.13" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.MacOS" Version="14.4.0-preview.2.26479.13" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0-preview.2.26479.13" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.4.0-preview.2.26479.13" />
    <PackageVersion Include="Material.Avalonia" Version="3.21.0" />
    <PackageVersion Include="Material.Icons" Version="3.0.2" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageVersion Include="ReactiveUI" Version="25.1.1" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.5" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0-preview.2.26479.13" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0-preview.2.26479.13" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.155.0-preview.2.26479.13" />
    <PackageVersion Include="Splat" Version="21.0.0" />
  </ItemGroup>
</Project>